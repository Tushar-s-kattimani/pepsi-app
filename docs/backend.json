
{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Represents a user's profile information.",
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "shopName": {
          "type": "string",
          "description": "The name of the user's shop."
        },
        "place": {
          "type": "string",
          "description": "The location or place of the user's shop."
        },
        "phoneNumber": {
          "type": "string",
          "description": "The user's contact phone number."
        }
      },
      "required": ["displayName", "email"]
    },
    "Shop": {
      "title": "Shop",
      "type": "object",
      "description": "Represents a shop or customer location that places orders.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the shop."
        },
        "address": {
          "type": "string",
          "description": "Address of the shop."
        },
        "contact": {
          "type": "string",
          "description": "Contact information for the shop."
        },
        "location": {
          "type": "string",
          "description": "GPS coordinates of the shop."
        },
        "outstandingBalance": {
          "type": "number",
          "description": "The outstanding balance of the shop."
        },
        "salesVolumeClass": {
          "type": "string",
          "description": "Classification of the shop by sales volume (A/B/C type)."
        },
        "creditLimit": {
          "type": "number",
          "description": "The credit limit assigned to the shop."
        }
      },
      "required": [
        "name",
        "address"
      ]
    },
    "Product": {
      "title": "Product",
      "type": "object",
      "description": "Represents a Pepsi product available for order.",
      "properties": {
        "sku": {
          "type": "string",
          "description": "Stock keeping unit of the product."
        },
        "name": {
          "type": "string",
          "description": "Name of the product."
        },
        "price": {
          "type": "number",
          "description": "Price of the product."
        },
        "size": {
          "type": "string",
          "description": "Size of the product (e.g., 500ml, 1L)."
        },
        "stock": {
            "type": "number",
            "description": "Number of units in stock."
        },
        "imageUrl": {
            "type": "string",
            "description": "URL of the product image."
        },
        "imageHint": {
            "type": "string",
            "description": "Hint for AI image generation."
        }
      },
      "required": [
        "sku",
        "name",
        "price",
        "stock"
      ]
    },
    "Order": {
      "title": "Order",
      "type": "object",
      "description": "Represents an order placed by a shop.",
      "properties": {
        "shopId": {
          "type": "string",
          "description": "ID of the shop that placed the order."
        },
        "shopName": {
            "type": "string",
            "description": "Denormalized name of the shop for display purposes."
        },
        "orderDate": {
          "type": "string",
          "description": "Date the order was placed.",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "description": "Status of the order (Pending, Confirmed, Dispatched, Delivered, Cancelled).",
          "enum": ["Pending", "Confirmed", "Dispatched", "Delivered", "Cancelled"]
        },
        "totalAmount": {
          "type": "number",
          "description": "Total amount of the order."
        },
        "itemCount": {
            "type": "number",
            "description": "Total number of items in the order."
        }
      },
      "required": [
        "shopId",
        "orderDate",
        "status",
        "totalAmount",
        "itemCount"
      ]
    }
  },
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Stores public information about a user."
    },
    "/products/{productId}": {
        "schema": {
            "$ref": "#/entities/Product"
        },
        "description": "Collection of all available products."
    },
    "/orders/{orderId}": {
        "schema": {
            "$ref": "#/entities/Order"
        },
        "description": "Collection of all orders from all shops."
    }
  }
}
