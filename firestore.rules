/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset prioritizes security by enforcing ownership and restricting unauthorized data access.
 * It leverages denormalization and helper functions to create efficient and maintainable rules.
 *
 * Data Structure:
 * - `/users/{userId}`: Stores user profiles. Access is restricted to the owner.
 * - `/products/{productId}`: Stores product information. Read access is public. Write access is not defined in the schema.
 * - `/orders/{orderId}`: Stores order information. Write access is not defined in the schema.
 *
 * Key Security Decisions:
 * - User listing is disabled to prevent unauthorized information harvesting.
 * - Public read access is enabled for the `/products` collection, assuming product information is intended to be public.
 * - The default security posture for ambiguous write relationships (e.g., to `/orders`) is to deny access and flag a TODO, pending further clarification.
 *
 * Denormalization for Authorization:
 * N/A. The current schema does not require denormalization for authorization.
 *
 * Structural Segregation:
 * N/A. No explicit segregation of private and public data is specified in the current schema.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Protects user profiles, ensuring only the owner can read and write their data.
     * @path /users/{userId}
     * @allow (read, write) if the user is the owner of the profile.
     * @deny (read, write) if the user is not the owner of the profile.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if false; // User listing is not allowed.
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Allows public read access to product information, but restricts write access.
     * @path /products/{productId}
     * @allow (get, list) to anyone.
     * @deny (create, update, delete) to everyone, until write permissions are defined.
     * @principle Allows public reads, but restricts writes.
     */
    match /products/{productId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Restricts access to orders. No access is granted until rules are defined.
     * @path /orders/{orderId}
     * @deny (get, list, create, update, delete) to everyone, until permissions are defined.
     * @principle Restricts all access to orders until rules are defined.
     */
    match /orders/{orderId} {
      allow get, list, create, update, delete: if false; // TODO: Implement order access control.
    }
  }
}