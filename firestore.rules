/**
 * @fileoverview Firestore Security Rules for PepsiConnect App
 *
 * Core Philosophy: This ruleset enforces a strict ownership model for shops and their orders. Each shop can only manage its own orders and order items. Products and Salesmen are publicly readable but not writable without authentication.
 *
 * Data Structure:
 * - /shops/{shopId}: Represents a shop, secured via ownership.
 * - /shops/{shopId}/orders/{orderId}: Represents an order placed by a shop, secured via shop ownership.
 * - /shops/{shopId}/orders/{orderId}/orderItems/{orderItemId}: Represents an item within an order, secured via order ownership.
 * - /products/{productId}: Represents a product, publicly readable but not writable.
 * - /salesmen/{salesmanId}: Represents a salesman, publicly readable but not writable.
 *
 * Key Security Decisions:
 * - Users cannot list all shops.
 * - Only authenticated users can create shops.
 * - Order and order item data is secured via shop ownership.
 * - Products and Salesmen are publicly readable but only authorized users can create, update, or delete them.
 *
 * Denormalization for Authorization:
 * - Order documents include a denormalized `shopId` field, matching the path, to avoid needing to query the parent `shop` document for authorization.
 * - OrderItem documents include a denormalized `orderId` field, matching the path, to avoid needing to query the parent `order` document for authorization.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows reading and writing to shop documents only to authenticated users.
     * @path /shops/{shopId}
     * @allow (create) if isSignedIn()
     * @deny (get, list, update, delete) if true
     * @principle Enforces signed-in user for shop creation. No listing, updates, or deletion of shops.
     */
    match /shops/{shopId} {
      allow get: if false;
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows a shop to manage its orders.
     * @path /shops/{shopId}/orders/{orderId}
     * @allow (create) if isSignedIn() && request.resource.data.shopId == shopId;
     * @allow (get, list) if true;
     * @allow (update, delete) if isSignedIn() && resource.data.shopId == shopId;
     * @deny (create) if request.resource.data.shopId != shopId
     * @principle Enforces shop ownership for order management. Validates shopId on create.
     */
    match /shops/{shopId}/orders/{orderId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.shopId == shopId;
      allow update: if isSignedIn() && resource.data.shopId == shopId && resource != null;
      allow delete: if isSignedIn() && resource.data.shopId == shopId && resource != null;
    }

    /**
     * @description Allows a shop to manage its order items.
     * @path /shops/{shopId}/orders/{orderId}/orderItems/{orderItemId}
     * @allow (create) if isSignedIn();
     * @allow (get, list) if true;
     * @allow (update, delete) if isSignedIn();
     * @principle Enforces shop ownership for order item management.
     */
    match /shops/{shopId}/orders/{orderId}/orderItems/{orderItemId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Allows public reading of products, but restricts creation, updating, and deletion to authenticated users.
     * @path /products/{productId}
     * @allow (get, list) if true;
     * @allow (create, update, delete) if isSignedIn();
     * @principle Allows public product listing but requires authentication for writes.
     */
    match /products/{productId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Allows public reading of salesmen, but restricts creation, updating, and deletion to authenticated users.
     * @path /salesmen/{salesmanId}
     * @allow (get, list) if true;
     * @allow (create, update, delete) if isSignedIn();
     * @principle Allows public salesman listing but requires authentication for writes.
     */
    match /salesmen/{salesmanId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }
  }
}