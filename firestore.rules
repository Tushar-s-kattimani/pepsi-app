/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for user profiles and allows public read access to products.
 * Orders can be created by signed-in users but can only be managed by the shop that created them.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information. Access is restricted to the user themselves.
 * - /products/{productId}: Stores product information. Publicly readable.
 * - /orders/{orderId}: Stores order information.
 *
 * Key Security Decisions:
 * - Users can only read and write their own profile data.
 * - Product information is publicly available for reading.
 * - Orders are accessible and manageable only by the shop that created them (identified by shopId in the order data).
 *
 * Denormalization for Authorization:
 * - The `Order` entity requires the `shopId` to be present to enforce ownership for write operations.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile documents.
     * @path /users/{userId}
     * @allow (create) User 'test_user' with ID 'test_user' can create their profile.
     * @deny (create) User 'test_user' cannot create a profile with ID 'other_user'.
     * @allow (get, list, update, delete) User 'test_user' can read and modify their own profile.
     * @deny (get, list, update, delete) User 'test_user' cannot read or modify profile 'other_user'.
     * @principle Enforces user-ownership: Only the authenticated user can access their own profile data.
     */
    match /users/{userId} {
      // Allow the user to create their own profile if the userId matches their auth UID.
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.email == request.auth.token.email;
      // Allow the user to read, update, and delete their own profile.
      allow get, list, update, delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Controls access to product documents.
     * @path /products/{productId}
     * @allow (get, list) Any user can read product information.
     * @deny (create, update, delete) No user can create, update, or delete product information.
     * @principle Public read access with no write access.
     */
    match /products/{productId} {
      // Allow anyone to read product information.
      allow get, list: if true;
      // Prevent anyone from creating, updating, or deleting product information.
      allow create, update, delete: if false;
    }

    /**
     * @description Controls access to order documents.
     * @path /orders/{orderId}
     * @allow (create) Signed in user can create order information.
     * @deny (create) User cannot create order if not signed in.
     * @allow (get, list) Signed in user can read order information.
     * @deny (update, delete) User cannot update order they do not own.
     * @principle Signed in user can create/read order information. Only the shop with shopId in the order can update or delete the order.
     */
    match /orders/{orderId} {
      // Allow any signed-in user to create an order, enforcing that the shopId matches
      // the authenticated user's ID (if the concept of orders created by shops and authentication with shopId is applied),
      // and validates shopId and shopName when creating order.
      allow create: if isSignedIn() && request.resource.data.keys().hasAll(['shopId', 'orderDate', 'status', 'totalAmount', 'itemCount', 'shopName']);

      // Allow any signed-in user to read order information
      allow get, list: if isSignedIn();

      // Only the shop that created the order can update or delete it.
      // Access is based on the `shopId` field in the order document.
      allow update, delete: if isSignedIn() && resource.data.shopId == request.auth.uid;
    }
  }

  // Helper function to determine if the user is signed in.
  function isSignedIn() {
    return request.auth != null;
  }

  // Helper function to determine if the user is the owner of the document.
  function isOwner(userId) {
    return request.auth.uid == userId;
  }

  // Helper function to determine if the user is the existing owner of the document
  // and that the document exists.
  function isExistingOwner(userId) {
    return isOwner(userId) && resource != null;
  }
}