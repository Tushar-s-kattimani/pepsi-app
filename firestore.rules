/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset prioritizes security by enforcing user-based access control and validating data relationships.
 * All write operations require authentication.
 *
 * Data Structure:
 * - /users/{userId}: Stores public user profile information. Access is restricted to the owning user.
 * - /products/{productId}: Stores product information. Read access is public, but write access is restricted to authenticated users.
 * - /orders/{orderId}: Stores order information. Write access is restricted to authenticated users.
 *
 * Key Security Decisions:
 * - User listing is disabled to prevent enumeration.
 * - The `products` collection is publicly readable to allow all users to view the product catalog.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile documents.
     * @path /users/{userId}
     * @allow (create) User with UID 'user_abc' can create their profile document.
     * @allow (get, list, update, delete) User with UID 'user_abc' can access their own profile.
     * @deny (create) User with UID 'user_xyz' cannot create a profile document for 'user_abc'.
     * @deny (get, list, update, delete) User with UID 'user_xyz' cannot access user 'user_abc' profile.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      // Helper function to check if the authenticated user is the owner of the document.
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      // Allow the user to create their own document, enforcing that the userId matches the auth.uid.
      allow create: if isOwner(userId);

      // Allow the user to get, update, and delete their own document.
      allow get, update, delete: if isOwner(userId) && resource != null;

      // Prevent listing of all users.
      allow list: if false;
    }

    /**
     * @description Controls access to product documents.
     * @path /products/{productId}
     * @allow (get, list) Any user can read product information.
     * @allow (create, update, delete) Authenticated users can manage product data.
     * @deny (create, update, delete) Unauthenticated users cannot manage product data.
     * @principle Allows public read access but restricts write access to authenticated users.
     */
    match /products/{productId} {
      // Allow anyone to read product information.
      allow get, list: if true;

      // Allow authenticated users to create, update, and delete products.
      allow create, update, delete: if isSignedIn();

      function isSignedIn() {
        return request.auth != null;
      }
    }

     /**
      * @description Controls access to order documents.
      * @path /orders/{orderId}
      * @allow (create, update, delete) Authenticated users can manage order data.
      * @deny (create, update, delete) Unauthenticated users cannot manage order data.
      */
    match /orders/{orderId} {
         // Allow authenticated users to create, update, and delete orders.
         allow create, update, delete: if isSignedIn();

         // Deny read and list access to orders.
         allow get, list: if false;

         function isSignedIn() {
            return request.auth != null;
         }
    }
  }
}