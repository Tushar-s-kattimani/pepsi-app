/**
 * @fileoverview Firestore Security Rules for the Pepsi Ordering App.
 *
 * Core Philosophy:
 * This ruleset prioritizes secure data access based on user identity and defined roles.
 * User data is protected using an ownership model, while product data is publicly readable but only writable by authorized users.
 * Orders can be created by anyone, but modification/deletion is restricted.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information; access is restricted to the owning user.
 * - /products/{productId}: Stores product information; publicly readable, writable by authorized users only.
 * - /orders/{orderId}: Stores order information; create is allowed to any signed-in user, but modification and deletion are restricted.
 *
 * Key Security Decisions:
 * - User listing is disallowed to prevent unauthorized data scraping.
 * - Product data is publicly readable to facilitate browsing without authentication.
 * - Order modifications and deletions are highly restricted for data integrity.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows access to user profile information only to the authenticated user.
     * @path /users/{userId}
     * @allow (read, write) if request.auth.uid == userId
     * @deny (read, write) if request.auth.uid != userId
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false; // Disallowing user listing for privacy.
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Allows public read access to product information, but restricts write access.
     * @path /products/{productId}
     * @allow (read) if true
     * @allow (write) if false // TODO: Add admin role check.
     * @deny (write) if true
     * @principle Allows public read access for product browsing, but restricts modification to authorized users only.
     */
    match /products/{productId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add admin role check.
    }

    /**
     * @description Allows creation of orders by any authenticated user, but restricts modification and deletion.
     * @path /orders/{orderId}
     * @allow (create) if request.auth != null
     * @deny (update, delete) always
     * @principle Allows order creation to any signed-in user, but restricts modification and deletion for data integrity.
     */
    match /orders/{orderId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isSignedIn() && isOwner(userId) && resource != null;
    }
  }
}