rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper function to check if the user is an admin by looking at their Firestore document
    function isAdmin() {
      return get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Rules for the 'products' folder
    match /products/{allPaths=**} {
      // Allow anyone to read product images. This is necessary for them to display in the shop.
      allow read;
      
      // Only allow admins to upload, update, or delete product images.
      allow write: if request.auth != null && isAdmin();
    }

    // Rules for user profile pictures
    match /user-profiles/{userId}/{allPaths=**} {
      // Allow anyone to read profile pictures
      allow read;
      // Allow a user to write (upload, update, delete) their own profile picture
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Fallback for other paths - deny all by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
