rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow read access to everyone for all files.
    // This allows images to be publicly viewable in your app.
    match /{allPaths=**} {
      allow read;
    }

    // Allow authenticated users to write (upload, update, delete) files
    // in a 'products' folder. This secures your storage so only logged-in
    // users (i.e., your admin) can manage product images.
    match /products/{allPaths=**} {
        allow write: if request.auth != null;
    }
  }
}
